# apps/backend/.env.test
#
# Local test defaults only. Values already present in the environment win:
# both dotenv-cli (the `test` scripts) and dotenv (tests/integration/helpers/setup.ts)
# load this file without `override`, so CI supplies its own DATABASE_URL and
# JWT_SECRET via the workflow env in .github/workflows/test.yaml.
DATABASE_URL="postgresql://postgres:password@localhost:5432/letterspace_test?schema=public"
JWT_SECRET="my-secret-key"
